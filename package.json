{
  "name": "@missher/dsh-reasoning-effort",
  "version": "0.7.5-local.12",
  "description": "DeepSeek Harness model and reasoning selector with a pixel depth slider, model-declared effort mapping, and settings-only theme colours.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "reasoning-effort",
    "thinking",
    "model-selector",
    "slider",
    "ui",
    "cordis"
  ],
  "author": "HanaAyane",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Missher12/dsh-reasoning-effort.git"
  },
  "homepage": "https://github.com/Missher12/dsh-reasoning-effort#readme",
  "bugs": {
    "url": "https://github.com/Missher12/dsh-reasoning-effort/issues"
  },
  "engines": {
    "node": ">=22.19"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "assets/chibi-runner-strip.png",
    "design",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-LICENSE.txt"
  ],
  "scripts": {
    "build": "pnpm run build:host && pnpm run build:client && pnpm run build:client-types",
    "build:host": "tsc -p tsconfig.build.json",
    "build:client": "node scripts/build-client.mjs && node scripts/check-client-load.mjs",
    "build:client-types": "tsc -p tsconfig.client.json",
    "test": "node scripts/test.mjs",
    "check:all": "node scripts/test.mjs && node scripts/check-client-load.mjs && node scripts/check-palette-click.mjs",
    "watch": "tsc -p tsconfig.json --watch",
    "watch:client": "node scripts/build-client.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check": "pnpm run typecheck && pnpm run check:i18n && pnpm run build",
    "check:client-load": "node scripts/check-client-load.mjs",
    "check:palette": "node scripts/check-palette-click.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-remotes": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-model-selection": "*",
    "@deepseek-ai/dsh-client-ui-renderer": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/schemastery": "3.18.4",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-settings-models": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "typescript": "^6.0.3",
    "react-dom": "^18.3.1",
    "@deepseek-ai/dsh-client-ui-settings-models": "0.2.0-rc.2"
  },
  "license": "MIT"
}
